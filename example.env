# This is an example .env file
# Create new .env file and copy envs replacing with proper values

# App port
PORT=8080
# To get, visit: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=ngrok-token
# To get, visit: https://t.me/BotFather
BOT_TOKEN=telegram-bot-token
# Log level
LOG_LEVEL=info
# Log format
# text | json | prettyjson
LOG_FORMAT=json
# Sourcing of caller the logger
LOG_SOURCE=false
# GCP project that owns the Firestore database used by /report.
# Emulator ignores the value, but config refuses empty. Required.
PROJECT_ID=golangua-telegram-butler
# FIRESTORE_EMULATOR_HOST is intentionally NOT defined here.
# The Taskfile wires the correct value per task:
#   run:local       → localhost:8085           (host can reach OrbStack's forwarded port)
#   run:docker      → host.docker.internal:8085 (Docker container reaches host via this DNS)
#   run:local:prod  → empty                    (SDK uses real GCP via ADC)
# If you invoke `go run` directly (no task), the var is unset → SDK uses real GCP.