# Local development Dockerfile.
# Differences from production Dockerfile:
# - Builds with "-tags local" to include ngrok tunnel (pre_setup_local.go)
# - No --platform=linux/amd64 constraint — builds natively on ARM Mac
# - Includes ca-certificates for ngrok HTTPS
FROM golang:1.26-alpine AS builder

WORKDIR /go/src/app

COPY go.mod go.sum ./
RUN go mod download

COPY ./cmd/ ./cmd/
COPY ./internal/ ./internal/

RUN go build -tags local -o main ./cmd/telegram-butler

FROM alpine:3.23

# CA certs needed for HTTPS (ngrok, Telegram API)
RUN apk add --no-cache ca-certificates

COPY --from=builder /go/src/app/main .

CMD ["./main"]
